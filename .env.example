PROJECT_NAME=factorissimo3-exclusively

# The factorio data directory, which holds the saves, scenarios and mods folders
FACTORIO_DIR=/path/to/factorio

# Optional, every path that is left out resolves from FACTORIO_DIR like a standalone install.
# Set FACTORIO_EXE for a steam install, since it keeps the executable elsewhere.
# FACTORIO_EXE=/path/to/factorio/bin/x64/factorio.exe
# FACTORIO_MOD_DIR=/path/to/factorio/mods
# FACTORIO_LOG=/path/to/factorio/factorio-current.log

# Optional, only passed to factorio when set
# FACTORIO_CONFIG=/path/to/factorio/config/config.ini
